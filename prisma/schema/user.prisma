model User {
    id        String   @id @default(uuid())
    name      String
    image     String?
    email     String?  @unique
    phone     String   @unique
    password  String
    role      UserRole @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    addresses Address?
    orders    Order[]
    carts     Cart[]
    reviews   Review[]

    @@index([phone])
    @@map("users")
}

enum UserRole {
    USER
    ADMIN
}
